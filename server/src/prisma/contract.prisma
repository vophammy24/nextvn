// use prisma-8

enum PlatformRole {
  USER
  ADMIN
}

enum BusinessRole {
  OWNER
  MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  OPEN
  CONFIRMED
  PAID
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  NEED_PAYMENT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum ShiftStatus {
  ACTIVE
  CLOSED
}

enum SalesServiceType {
  TAKEAWAY
  DINE_IN
  BOTH
}

enum CounterPaymentPolicy {
  IMMEDIATE_ONLY
  PAY_LATER_ALLOWED
  STAFF_CHOICE
}

enum DineInOrderingMode {
  COUNTER_ONLY
  TABLE_ONLY
  BOTH
}

enum OrderOrderingMode {
  COUNTER
  TABLE
}

model User {
  id           Uuid         @id @default(uuid())
  email        String       @unique
  username     String?      @unique
  passwordHash String
  fullName     String
  platformRole PlatformRole @default(USER)
  status       UserStatus   @default(ACTIVE)
  credentialVersion Int @default(0)
  /// Legacy metadata from an applied migration; unused by recovery. Recovery uses email.
  recoveryEmailVerifiedAt TimestamptzString?
  passwordResetTokens PasswordResetToken[]
  authSecurityEvents AuthSecurityEvent[]

  memberships BusinessMember[]
  submittedApplications BusinessApplication[] @relation("ApplicationOwner")
  reviewedApplications BusinessApplication[] @relation("ApplicationReviewer")
  adminAuditEvents AdminAuditEvent[]
  sentInvitations BusinessInvitation[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model PasswordResetToken {
  id Uuid @id @default(uuid())
  userId Uuid @unique
  user User @relation(fields: [userId], references: [id])
  tokenHash String @unique
  credentialVersion Int
  expiresAt TimestamptzString
  consumedAt TimestamptzString?
  createdAt TimestamptzString @default(now())
  @@index([expiresAt])
}

model PasswordResetThrottle {
  id String @id
  hits Int
  windowEndsAt TimestamptzString
  lastRequestAt TimestamptzString
  @@index([windowEndsAt])
}

model AuthSecurityEvent {
  id Uuid @id @default(uuid())
  userId Uuid
  user User @relation(fields: [userId], references: [id])
  action String
  createdAt TimestamptzString @default(now())
  @@index([userId, createdAt])
}

model Business {
  approvalStatus BusinessApprovalStatus @default(APPROVED)
  operationalStatus BusinessOperationalStatus @default(ACTIVE)
  id   Uuid   @id @default(uuid())
  name String

  members  BusinessMember[]
  branches Branch[]
  settings BusinessSettings?
  subscription BusinessSubscription?
  billingRecords BillingRecord[]
  application BusinessApplication?
  invitations BusinessInvitation[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model BusinessMember {
  id Uuid @id @default(uuid())

  businessId Uuid
  business   Business @relation(fields: [businessId], references: [id])

  userId Uuid
  user   User @relation(fields: [userId], references: [id])

  branchId Uuid?
  branch   Branch? @relation(fields: [branchId], references: [id])

  role     BusinessRole
  isActive Boolean      @default(true)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([businessId, userId])
  @@index([userId])
  @@index([branchId])
}

model Branch {
  invitations BusinessInvitation[]
  id Uuid @id @default(uuid())

  businessId Uuid
  business   Business @relation(fields: [businessId], references: [id])

  name     String
  address  String?
  phone    String?
  isActive Boolean @default(true)
  salesSettings BranchSalesSettings?

  menuCategories  MenuCategory[]
  menuItems       MenuItem[]
  restaurantAreas RestaurantArea[]
  restaurantTables RestaurantTable[]
  orders          Order[]
  shifts          Shift[]

  members           BusinessMember[]
  ingredients       Ingredient[]
  recipes           Recipe[]
  stockTransactions StockTransaction[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([businessId])
}

model BranchSalesSettings {
  id Uuid @id @default(uuid())
  branchId Uuid @unique
  branch Branch @relation(fields: [branchId], references: [id])
  serviceType SalesServiceType @default(BOTH)
  counterPaymentPolicy CounterPaymentPolicy @default(IMMEDIATE_ONLY)
  dineInOrderingMode DineInOrderingMode @default(BOTH)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum InvitationDeliveryStatus {
  PENDING_DELIVERY
  SENT
  FAILED
}

model BusinessInvitation {
  id Uuid @id @default(uuid())
  businessId Uuid
  business Business @relation(fields: [businessId], references: [id])
  invitedByUserId Uuid
  invitedBy User @relation(fields: [invitedByUserId], references: [id])
  branchId Uuid
  branch Branch @relation(fields: [branchId], references: [id])
  email String
  fullName String
  role BusinessRole
  status InvitationStatus @default(PENDING)
  deliveryStatus InvitationDeliveryStatus @default(PENDING_DELIVERY)
  tokenHash String @unique
  attemptId Uuid
  expiresAt TimestamptzString
  attemptedAt TimestamptzString @default(now())
  acceptedAt TimestamptzString?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([businessId, email])
  @@index([businessId, createdAt])
}

model MenuCategory {
  id Uuid @id @default(uuid())

  branchId Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  name        String
  displayOrder Int    @default(0)
  isActive     Boolean @default(true)

  items MenuItem[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([branchId])
}

model MenuItem {
  id Uuid @id @default(uuid())

  branchId Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  categoryId Uuid
  category   MenuCategory @relation(fields: [categoryId], references: [id])

  name        String
  description String?
  price       Int
  imageUrl    String?
  isActive    Boolean @default(true)

  orderItems OrderItem[]
  recipe Recipe?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([branchId])
  @@index([categoryId])
}

model RestaurantArea {
  id Uuid @id @default(uuid())

  branchId Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  name         String
  displayOrder Int    @default(0)
  isActive Boolean @default(true)

  tables RestaurantTable[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([branchId])
}

model RestaurantTable {
  id Uuid @id @default(uuid())

  branchId Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  areaId Uuid
  area   RestaurantArea @relation(fields: [areaId], references: [id])

  name     String
  seats    Int        @default(4)
  status   TableStatus @default(AVAILABLE)
  isActive Boolean @default(true)

  orders Order[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([branchId])
  @@index([areaId])
}

model Order {
  id Uuid @id @default(uuid())

  branchId Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  tableId Uuid?
  table   RestaurantTable? @relation(fields: [tableId], references: [id])

  shiftId Uuid?
  shift   Shift? @relation(fields: [shiftId], references: [id])

  cashierId Uuid
  orderType OrderType  @default(DINE_IN)
  status    OrderStatus @default(OPEN)
  orderingMode OrderOrderingMode?
  requestKey Uuid? @unique
  requestHash String?
  revision Int @default(1)

  subtotal  Int @default(0)
  discount  Int @default(0)
  total     Int @default(0)

  note String?

  items    OrderItem[]
  payments OrderPayment[]
  inventoryTransactions StockTransaction[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([branchId])
  @@index([shiftId])
  @@index([cashierId])
}

model OrderItem {
  id Uuid @id @default(uuid())

  orderId Uuid
  order   Order @relation(fields: [orderId], references: [id])

  menuItemId Uuid
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  name      String
  unitPrice Int
  quantity  Int    @default(1)
  total     Int

  note String?
  modifierKeys Json?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([orderId])
}

model OrderPayment {
  id Uuid @id @default(uuid())

  orderId Uuid
  order   Order @relation(fields: [orderId], references: [id])

  method PaymentMethod
  amount Int
  shiftId Uuid?
  confirmedBy Uuid?

  createdAt TimestamptzString @default(now())

  @@index([orderId])
}

model Shift {
  id Uuid @id @default(uuid())

  branchId Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  staffId Uuid
  status  ShiftStatus @default(ACTIVE)

  startedAt TimestamptzString @default(now())
  endedAt   TimestamptzString?

  orders Order[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([branchId])
  @@index([staffId])
}

enum InventoryUnit {
  G
  ML
  PIECE
}

enum StockTransactionType {
  IMPORT
  EXPORT
  ADJUSTMENT
  WASTE
  SALE_CONSUMPTION
}

enum InventoryAlertType {
  LOW_STOCK
  OUT_OF_STOCK
  NEAR_EXPIRY
}

enum InventoryAlertStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Ingredient {
  id Uuid @id @default(uuid())

  businessId Uuid

  branchId Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  name     String
  category String
  unit     InventoryUnit

  balance     InventoryBalance?
  lots        InventoryLot[]
  recipeParts RecipeIngredient[]
  alerts      InventoryAlert[]

  @@index([businessId, branchId])
}

model InventoryBalance {
  id Uuid @id @default(uuid())

  ingredientId Uuid       @unique
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  quantityMilli Int   @default(0)
  minimumMilli  Int   @default(0)
  unitCost      Float @default(0)
}

model InventoryLot {
  id Uuid @id @default(uuid())

  ingredientId Uuid
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  quantityMilli Int
  expiry        String?

  createdAt TimestamptzString @default(now())

  @@index([ingredientId])
}

model Recipe {
  id Uuid @id @default(uuid())

  businessId Uuid

  branchId Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  menuItemId Uuid     @unique
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  name         String
  sellingPrice Float
  version      Int    @default(1)
  modifiers    Json

  ingredients RecipeIngredient[]

  @@index([businessId, branchId])
}

model RecipeIngredient {
  id Uuid @id @default(uuid())

  recipeId Uuid
  recipe   Recipe @relation(fields: [recipeId], references: [id])

  ingredientId Uuid
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  quantityMilli Int
  modifierKey   String

  @@unique([recipeId, ingredientId, modifierKey])
}

model StockTransaction {
  id Uuid @id @default(uuid())

  businessId Uuid

  branchId Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  actorId Uuid

  type StockTransactionType

  requestKey  String
  requestHash String

  orderId Uuid?
  order   Order? @relation(fields: [orderId], references: [id])

  note     String
  supplier String
  items    Json

  createdAt TimestamptzString @default(now())

  @@unique([businessId, branchId, requestKey])
  @@unique([businessId, orderId])
  @@index([branchId])
}

model InventoryAlert {
  id Uuid @id @default(uuid())

  businessId Uuid
  branchId   Uuid

  ingredientId Uuid
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  type            InventoryAlertType
  status          InventoryAlertStatus
  conditionActive Boolean

  updatedAt TimestamptzString @default(now())

  @@unique([businessId, branchId, ingredientId, type])
  @@index([branchId])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model BusinessSettings {
  businessId Uuid @id
  business Business @relation(fields: [businessId], references: [id])

  contactEmail String?
  contactPhone String?
  address String?
  taxRate Float @default(0)
  serviceChargeRate Float @default(0)
  currency String @default("VND")
  locale String @default("vi-VN")
  invoicePrefix String @default("NEXTVN")
  receiptTitle String?
  receiptFooter String?
  notifyLowStock Boolean @default(true)
  notifyNearExpiry Boolean @default(true)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model SubscriptionPlan {
  id Uuid @id

  code String @unique
  name String
  description String?
  monthlyPriceVnd Int?
  annualPriceVnd Int?
  isActive Boolean @default(true)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  subscriptions BusinessSubscription[]
}

model BusinessSubscription {
  id Uuid @id

  businessId Uuid @unique
  business Business @relation(fields: [businessId], references: [id])

  planId Uuid
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(TRIALING)
  startedAt TimestamptzString @default(now())
  periodEndsAt TimestamptzString?
  providerReference String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  billingRecords BillingRecord[]
}

model BillingRecord {
  id Uuid @id

  businessId Uuid
  business Business @relation(fields: [businessId], references: [id])

  subscriptionId Uuid
  subscription BusinessSubscription @relation(fields: [subscriptionId], references: [id])

  amountVnd Int
  currency String @default("VND")
  status BillingStatus @default(PENDING)
  providerReference String? @unique
  providerEventId String? @unique
  createdAt TimestamptzString @default(now())
  paidAt TimestamptzString?

  @@index([businessId, createdAt])
  @@index([subscriptionId])
}

enum BusinessApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BusinessOperationalStatus {
  ACTIVE
  SUSPENDED
}

model BusinessApplication {
  id Uuid @id @default(uuid())
  businessId Uuid @unique
  business Business @relation(fields: [businessId], references: [id])
  ownerId Uuid
  owner User @relation("ApplicationOwner", fields: [ownerId], references: [id])
  status BusinessApprovalStatus @default(PENDING)
  contactPhone String
  address String
  submittedAt TimestamptzString @default(now())
  reviewedAt TimestamptzString?
  reviewerId Uuid?
  reviewer User? @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  reviewReason String?

  @@index([status, submittedAt])
  @@index([ownerId])
}

model AdminAuditEvent {
  id Uuid @id @default(uuid())
  actorId Uuid
  actor User @relation(fields: [actorId], references: [id])
  action String
  entityType String
  entityId Uuid
  previousStatus String?
  newStatus String
  reason String?
  correlationId String
  createdAt TimestamptzString @default(now())

  @@index([createdAt])
  @@index([entityId, createdAt])
  @@index([action, createdAt])
}
